# Network switch: "testnet" (default) or "mainnet". One deployment serves one
# network; the contracts, read model and receipt issuer all follow this switch.
NEXT_PUBLIC_ARC_NETWORK=testnet

# Arc Mainnet overrides. The published values (chain id 5042, RPC
# https://rpc.mainnet.arc.io, explorer https://explorer.arc.io, USDC
# 0x3600000000000000000000000000000000000000) are built in; set these only to
# use a keyed RPC provider or a different explorer. The chain id is fixed.
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=
NEXT_PUBLIC_ARC_MAINNET_WS_URL=
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=
NEXT_PUBLIC_ARC_MAINNET_USDC_ADDRESS=

# Public Arc Testnet values. NEXT_PUBLIC_* values are visible in the browser.
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
# Testnet-only explorer override; ignored on mainnet (see NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL).
NEXT_PUBLIC_ARCSCAN_URL=https://testnet.arcscan.app
# Contract and USDC addresses are not environment variables: the app, API and indexer read
# packages/contracts/deployments/arc-<network>.json, which the deploy script writes.

# Supabase read-model integration. The service role key is server-only.
NEXT_PUBLIC_APP_URL=https://thearcanum.in
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server/API runtime. Do not put these values in NEXT_PUBLIC variables.
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
# The API, web RPC proxy, and indexer read this optional RPC override.
ARC_RPC_URL=
# Indexer-only RPC override (a keyed provider goes here). Unset, the indexer
# backfills through the public Tenderly gateway at one request per second; the
# official endpoint above rejects the merged log queries Ponder sends. See
# packages/indexer/ponder.config.ts and docs/INDEXER-TOPUP.md.
INDEXER_RPC_URL=
INDEXER_RPC_REQUESTS_PER_SECOND=1
SIWE_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
ARCANUM_OPEN_REGISTRATION=true
ARCANUM_DEPLOYMENT_MODE=supabase
# The API reads this to require authentication outside production.
ARCANUM_REQUIRE_AUTH=
# The API signs payment decision receipts with this key. It must match an active
# entry in packages/shared/src/receipts/issuers.ts for the current chain.
ARCANUM_RECEIPT_ISSUER_PRIVATE_KEY=
# The database package reads this fallback tenant identifier.
ARCANUM_TENANT_ID=
# Auth reads host-specific tenant mappings using this naming convention.
ARCANUM_TENANT_APP_EXAMPLE_COM=
# API health checks read this staleness threshold.
ARCANUM_INDEXER_STALE_AFTER_MINUTES=
# The indexer reads this to disable its PostgreSQL mirror.
ARCANUM_DISABLE_PG_MIRROR=

# Optional legacy local tooling only. Vercel web/API runtime does not use DATABASE_URL.
DATABASE_URL=

# Optional demo workspace gating read by the API.
ARCANUM_DEMO_OWNER_WALLET=

# The API and indexer read this server-side Supabase URL override.
SUPABASE_URL=

# Web development routes read these test-wallet settings.
ARCANUM_ENABLE_TEST_WALLET=
ARCANUM_TEST_WALLET_FILE=
NEXT_PUBLIC_ARCANUM_TEST_WALLET=

# The web wallet provider reads this WalletConnect project identifier.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only local deployment credentials. Not required for normal web runtime.
# Never commit real values.
DEPLOYER_PRIVATE_KEY=
ARC_PROTOCOL_ADMIN=
ANOMALY_ORACLE_SIGNER_ADDRESS=
# Defaults to 86400 seconds when omitted.
ANOMALY_MAX_SCORE_AGE_SECONDS=
# Optional bytes32 override of the fixed CREATE2 salt; only for recovering a partial broadcast.
ARC_DEPLOY_SALT=

# Arc Mainnet values for non-browser code. The Python SDK has the published
# values built in and treats these as overrides. The mainnet contract deploy
# script (packages/contracts/script/DeployArcMainnet.s.sol) requires the chain
# id and USDC address explicitly, as a second confirmation of the target chain:
# ARC_MAINNET_CHAIN_ID=5042 and ARC_MAINNET_USDC_ADDRESS=0x3600...0000.
ARC_MAINNET_CHAIN_ID=
ARC_MAINNET_RPC_URL=
ARC_MAINNET_EXPLORER_URL=
ARC_MAINNET_USDC_ADDRESS=

# Shared rate-limit backend. Without it the API falls back to a per-process
# ceiling that does not hold across instances. Set
# ARCANUM_REQUIRE_RATE_LIMIT_BACKEND=true to refuse to serve instead of
# accepting the weaker guarantee.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ARCANUM_REQUIRE_RATE_LIMIT_BACKEND=

# Sign-in hardening. ARCANUM_SIWE_DOMAIN is required in production and must be
# the exact host for which SIWE messages are signed.
ARCANUM_SIWE_DOMAIN=
ARCANUM_ENFORCE_SIWE_DOMAIN=
# Only for running a production build over plain http locally.
ARCANUM_INSECURE_COOKIES=
# In production, sign-in refuses to issue a session when no identity record can
# be written (no DATABASE_URL and no working Supabase service role). Set this to
# true only for a deliberately storage-less deployment.
ARCANUM_ALLOW_UNBACKED_SESSIONS=

# Optional telemetry, off unless the switch is "on" AND a key/DSN is present.
NEXT_PUBLIC_ARCANUM_TELEMETRY=
ARCANUM_TELEMETRY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN_WEB=
SENTRY_DSN_WEB=
