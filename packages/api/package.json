{
  "name": "@arcanum/api",
  "version": "2.0.0",
  "description": "tRPC API layer with session-aware Supabase read models",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/dev.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@arcanum/auth": "2.0.0",
    "@arcanum/contracts": "2.0.0",
    "@arcanum/db": "2.0.0",
    "@arcanum/shared": "2.0.0",
    "@trpc/server": "^11.0.0",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.34.3",
    "superjson": "^2.2.1",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@arcanum/config": "2.0.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
