{
  "name": "@arcanum/sdk",
  "version": "2.0.0",
  "description": "TypeScript SDK for integrating Arcanum governed wallets",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./chains": {
      "import": {
        "types": "./dist/chains.d.ts",
        "default": "./dist/chains.js"
      },
      "require": {
        "types": "./dist/chains.d.cts",
        "default": "./dist/chains.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/chains.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "size": "size-limit",
    "build:publish": "tsup --config tsup.publish.config.ts && tsup --config tsup.publish.dts.config.ts && node scripts/rewrite-dts.mjs"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "dependencies": {
    "@arcanum/contracts": "2.0.0",
    "@arcanum/shared": "2.0.0"
  },
  "devDependencies": {
    "@arcanum/config": "2.0.0",
    "@size-limit/preset-small-lib": "^11.1.6",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7",
    "viem": "^2.21.0"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "35 KB"
    }
  ]
}
