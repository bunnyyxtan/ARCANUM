{
  "extends": ["../../biome.json"],
  "linter": {
    "rules": {
      "a11y": {
        "useButtonType": "off",
        "noLabelWithoutControl": "off",
        "noAutofocus": "off",
        "useSemanticElements": "off",
        "useKeyWithClickEvents": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off"
      }
    }
  }
}
